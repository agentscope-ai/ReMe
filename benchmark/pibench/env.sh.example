#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════
# pibench 评测套件环境配置模板
# 用法: cp env.sh.example env.sh  然后填写下面标记 TODO 的项
# ⚠️  env.sh 含真实 API key，切勿提交 git 或外传（已在 .gitignore 中排除）
# ═══════════════════════════════════════════════════════════════════════

SUITE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── TODO: π-Bench 仓库根目录 ─────────────────────────────────────────
# 必须包含 src/、data/、scripts/test_server.py、third_party/appworld 与 .venv
export PI_BENCH_ROOT=""

# ─── ReMe 仓库 ─────────────────────────────────────────────────────────
# 默认取本目录的上两级（适用于本套件放在 ReMe/benchmark/pibench 的情形）；
# 若套件位于其他位置，请改为 ReMe 仓库根目录的实际路径。
export REME_DIR="${REME_DIR:-$(cd "${SUITE_DIR}/../.." && pwd)}"

# ─── 被测 agent 的基模（ReMe agent 使用的 LLM）────────────────────────
export REME_MODEL_NAME="${REME_MODEL_NAME:-qwen3.6-plus}"

# ─── LLM 服务端点（默认 DashScope OpenAI 兼容端点，可换成任意兼容服务）──
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
export REME_LLM_BASE_URL="${REME_LLM_BASE_URL:-${DASHSCOPE_BASE_URL}}"

# ─── TODO: API keys ───────────────────────────────────────────────────
# USER_API_KEY : 驱动"模拟用户"的 LLM（run 阶段判定隐藏意图是否满足并追问）
# JUDGER_API_KEY: 驱动"裁判"的 LLM（eval 阶段对照 checklist 逐条打分）
# 两者可相同也可不同，推荐同一个 strong model。
export USER_BASE_URL="${DASHSCOPE_BASE_URL}"
export USER_API_KEY="TODO-fill-in-user-agent-api-key"

export JUDGER_BASE_URL="${DASHSCOPE_BASE_URL}"
export JUDGER_API_KEY="TODO-fill-in-judger-api-key"

# ReMe agent 的 key 默认复用 USER_API_KEY（同一服务同一 key 时不用重复填）
export REME_LLM_API_KEY="${REME_LLM_API_KEY:-${USER_API_KEY}}"

# Brave Search（可选，agent 的 web_search 工具用；不使用填 dummy 即可）
export BRAVE_SEARCH_API_KEY="TODO-optional-brave-search-key-or-dummy"

# ─── 持久化记忆 workspace（每 persona 独立子目录，自动创建）────────────
export REME_WORKSPACE_ROOT="${REME_WORKSPACE_ROOT:-${SUITE_DIR}/reme_workspace}"

# ─── 以下变量供 ReMe 的 default.yaml 模型配置展开，勿删 ───────────────
export LLM_MODEL_NAME="${REME_MODEL_NAME}"
export LLM_BASE_URL="${REME_LLM_BASE_URL}"
export LLM_API_KEY="${REME_LLM_API_KEY}"
