{
  "name": "reme-studio",
  "private": true,
  "workspaces": [
    "desktop",
    "web",
    "workbench",
    "client",
    "mobile"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:desktop": "npm run dev -w desktop",
    "build:static": "npm run build -w web",
    "build:desktop": "npm run build -w desktop",
    "build:mobile": "npm run build -w mobile --",
    "typecheck": "npm run typecheck -w desktop -w web -w mobile",
    "test": "npm run test -w client -w workbench -w desktop -w mobile",
    "format": "prettier --write \"**/*.{cjs,css,cts,html,js,json,jsx,mjs,mts,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{cjs,css,cts,html,js,json,jsx,mjs,mts,ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.8"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@electron/universal": {
      "minimatch": "^11.0.9"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.9"
    }
  }
}
