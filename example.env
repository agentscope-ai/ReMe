# Copy to .env and fill in credentials for the models you use.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen3.7-plus

# Optional DashScope speech recognition, synthesis, and dashscope_search.
# DASHSCOPE_API_KEY=sk-xxx

# Headless servers and containers can supply a persistent Fernet encryption key.
# Desktop hosts use their system credential store by default.
# Generate once with cryptography.fernet.Fernet.generate_key().
# REME_ENCRYPTION_KEY=
# Enable authenticated administration over HTTPS with an independently generated random token.
# REME_ADMIN_TOKEN=

# Optional decision models: install reme-ai[core,decision].
# Setting these variables alone does not enable an as_decision_model component.
# DECISION_MODEL_API_KEY=your-typesafe-api-key
# DECISION_MODEL_BACKEND=agentscope
# DECISION_MODEL_NAME=null
# Omit the model name or use null for the adapter default.
# DECISION_MODEL_BASE_URL=null

# Optional data-source mirrors. Unset variables use the official services.
# HF_MIRROR_URL=https://hf-mirror.com
# ARXIV_MIRROR_URL=https://export.arxiv.org

# Optional process timezone used when the application has no explicit timezone setting.
# TZ=Asia/Shanghai

# Optional Docker Compose settings. Create the host workspace before starting.
# REME_DATA_DIR=./.reme
# REME_PUBLISHED_PORT=2333
# On Linux, use the workspace owner's UID and GID when they differ from 1000.
# REME_UID=1000
# REME_GID=1000
# REME_CONFIG=/etc/reme/config.yaml
# REME_IMAGE=ghcr.io/agentscope-ai/reme:main
